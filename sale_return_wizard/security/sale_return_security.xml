<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sale_return_user" model="res.groups">
        <field name="name">Returns &amp; Credit Notes</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Can open the Return / Credit wizard on confirmed sale orders. Creating
            return pickings additionally requires Inventory / User, posting credit notes requires
            Invoicing / Billing.</field>
    </record>

    <!-- Sales managers get the feature out of the box -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sale_return_wizard.group_sale_return_user'))]"/>
    </record>

    <!-- Multi-company -->
    <record id="sale_return_log_company_rule" model="ir.rule">
        <field name="name">Sale return log: multi-company</field>
        <field name="model_id" ref="model_sale_return_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
