<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_sale_return_wizard" model="ir.ui.view">
        <field name="name">stock.picking.form.sale.return.wizard</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='do_print_picking']" position="before">
                <field name="sale_return_wizard_allowed" invisible="1"/>
                <button name="action_open_sale_return_wizard" type="object"
                        string="Return / Credit" icon="fa-undo"
                        groups="sale_return_wizard.group_sale_return_user"
                        invisible="not sale_return_wizard_allowed"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sale_return_logs" type="object"
                        class="oe_stat_button" icon="fa-history"
                        groups="sales_team.group_sale_salesman"
                        invisible="sale_return_log_count == 0">
                    <field name="sale_return_log_count" widget="statinfo" string="Return Logs"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
